# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test + coverage output (`make coverage` writes these; CI uploads coverage.xml
# as an artifact rather than committing it)
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
.coverage.*
junit*.xml
test-results/

# Jupyter
.ipynb_checkpoints/

# LLM debug transcripts. Opt-in (USERSIM_DEBUG_LOG) and defaulted under
# output/, but match them anywhere: they hold full prompts, completions,
# and reasoning content.
debug_llm_responses.jsonl
debug_litellm_requests.jsonl

# Credentials
.env
.env.*

# Local model configs. Keep private endpoints out of the repository: name any
# models file carrying your own endpoint `models.local.toml`.
models.local.toml
*.local.toml
# Local spec layers, such as an identity spec naming unpublished models.
*.local.yaml

# Data artifacts
/data/
/artifacts/
/output/
# Dense-retrieval vectors `gen-assets` writes beside a bank stay local.
src/usersim/engine/assets/financial_services/**/embeddings.parquet
# So do the judge scorecards `evaluate-assets` writes there.
src/usersim/engine/assets/financial_services/**/_eval_scorecard.parquet
src/usersim/engine/assets/financial_services/**/_scorecards/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local DataDesigner branch checkout
.dd-branch/

# Cursor
.cursor/

# Private agent overrides and session artifacts; shared guidance stays trackable.
AGENTS.local.md
CLAUDE.local.md
