# Multi-platform manifest verified with docker buildx imagetools inspect.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS tests
RUN apt-get update && apt-get install -y --no-install-recommends git make \
    && python -c 'import shutil; shutil.rmtree("/var/lib/apt/lists")'
WORKDIR /workspace
COPY . .
# pyproject.toml owns the uv version; no second pin belongs here.
RUN python -c 'import tomllib, subprocess; p=tomllib.load(open("pyproject.toml", "rb")); v=p["tool"]["uv"]["required-version"]; assert v.startswith("=="), "container requires an exact uv declaration"; subprocess.run(["python", "-m", "pip", "install", "--no-cache-dir", "uv"+v], check=True)'
ENV UV_PROJECT_ENVIRONMENT=/opt/unit UV_PYTHON_DOWNLOADS=never \
    DO_NOT_TRACK=1 HF_HUB_DISABLE_TELEMETRY=1 LITELLM_TELEMETRY=False
RUN uv sync --locked && uv build --wheel --out-dir /opt/wheels \
    && python scripts/run_e2e.py --work-dir /opt/e2e --wheel /opt/wheels/*.whl --prepare-only \
    && chmod -R a+rwX /workspace /opt/e2e
ENV UV_OFFLINE=1 UV_NO_SYNC=1 UV_CACHE_DIR=/tmp/uv-cache HOME=/tmp/home
CMD ["python", "scripts/run_container_tests.py", "inside"]

# Export this stage to inspect exactly the context used by COPY above.
FROM scratch AS context-audit
COPY . /
