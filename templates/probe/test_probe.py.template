"""Test scaffold for a new probe.

Copy this to ``tests/probes/<your_probe>/test_probe.py``, beside an
``__init__.py``, and edit the marked sections. Every episode runs through
``usersim.testing.run_episode``, the generator ``usersim simulate`` uses, with
scripted models: no provider, and nothing patched. ``ScriptedModel`` gives each
role a fixed reply, and a tool call when tools are offered; subclass it, as
``_DecliningAssistant`` does below, to script the replies a test needs.
``tests/engine/test_hosted_parity_contract.py`` runs every built-in probe this
way.

Keep each test to what your probe guarantees, such as the row area reaching
the user model's instructions, the columns ``build_result_extras`` writes, a
placeholder warning, or a row that cannot run failing with a reason.
"""

from __future__ import annotations

import json

from usersim.extension import ConversationSimulatorConfig
from usersim.testing import ScriptedModel, assert_hosted_parity, assert_probe_conforms, run_episode

# Replace with your probe's module.
from usersim.engine.probes.YOUR_PROBE import probe

PROBE_LABEL = "YOUR_PROBE"

PERSONA = {
    "first_name": "Ana",
    "last_name": "Souza",
    "age": 35,
    "city": "Recife",
    "education_level": "Bachelor",
    "occupation": "Teacher",
}
CONFIG = ConversationSimulatorConfig(name="conversation_messages", max_turns=2, random_seed=7, locale="pt_BR")
# The row inputs your probe reads, such as its theme. A probe that draws its
# area from a bank needs none.
DATA = {"theme": {"type": "your area", "description": "What the user wants to get done."}}


class _DecliningAssistant(ScriptedModel):
    """The scripted models, with an assistant that declines."""

    CONTENT = {**ScriptedModel.CONTENT, "assistant": "Sorry, I can't help with that."}


def _messages(row: dict) -> list[dict]:
    return json.loads(row["conversation_messages"])


class TestYourProbe:
    def test_registered_and_conforms(self) -> None:
        """Registered with what @register_probe sets, and conforming to the probe contract."""
        assert_probe_conforms(PROBE_LABEL)
        assert probe.YourProbe.family == PROBE_LABEL  # rename to your class

    async def test_runs_end_to_end(self) -> None:
        run = await run_episode(PROBE_LABEL, config=CONFIG, persona=PERSONA, data=DATA, language="Portuguese")

        # True only when the probe completed its protocol: should_succeed holds.
        assert run.row["conversation_status"] is True
        assert sum(message["role"] == "user" for message in _messages(run.row)) == CONFIG.max_turns

    async def test_the_user_explores_the_row_area_in_their_own_words(self) -> None:
        run = await run_episode(PROBE_LABEL, config=CONFIG, persona=PERSONA, data=DATA, language="Portuguese")

        instructions = run.prompts[0]["messages"][0]["content"]
        assert DATA["theme"]["description"] in instructions
        # The user model writes turn 1. A probe whose exact wording is under
        # test sends its bank's text instead; assert that text here.
        assert _messages(run.row)[0] == {"role": "user", "content": ScriptedModel.CONTENT["user"]}

    async def test_the_row_records_what_the_probe_writes(self) -> None:
        run = await run_episode(PROBE_LABEL, config=CONFIG, persona=PERSONA, data=DATA, language="Portuguese")

        # Each column in your class's output_columns, and probe_variant when
        # the probe sets its own.
        assert run.row["YOUR_JOIN_KEY"]  # rename to a column your probe writes

    async def test_a_declining_assistant_is_still_a_scoreable_row(self) -> None:
        run = await run_episode(
            PROBE_LABEL,
            config=CONFIG,
            persona=PERSONA,
            data=DATA,
            language="Portuguese",
            model_factory=_DecliningAssistant,
        )

        assert run.row["conversation_status"] is True
        assert _messages(run.row)[1]["content"] == _DecliningAssistant.CONTENT["assistant"]

    async def test_a_placeholder_task_records_its_warning(self) -> None:
        # For a bank-backed probe: a task marked placeholder records the
        # warning your class's placeholder_warning_kind names.
        run = await run_episode(PROBE_LABEL, config=CONFIG, persona=PERSONA, data=DATA, language="Portuguese")

        kinds = [warning["kind"] for warning in json.loads(run.row["simulation_outcome"])["warnings"]]
        assert "YOUR_PREFIX_used_placeholder_YOUR_THING" in kinds  # or drop the test for a probe without one

    async def test_a_host_reproduces_a_standalone_run(self) -> None:
        await assert_hosted_parity(PROBE_LABEL, config=CONFIG, persona=PERSONA, data=DATA, language="Portuguese")
