PROBE_LABEL = "YOUR_PROBE"


# ─── Shared helpers ────────────────────────────────────────────────


def _mock_call_llm(
    *,
    user_responses: List[Any] | None = None,
    assistant_responses: List[Any] | None = None,
    judge_responses: List[str] | None = None,
):
    """Alias-dispatching mock for acall_llm.

    Returns a side_effect callable that pops from the right queue
    based on the alias kwarg. Resilient to gate retries reordering
    user/judge calls within a single user turn.

    Judge responses MUST be XML-shaped strings:
        '<rating>PASS</rating><explanation>...</explanation>'
    or:
        '<rating>FAIL</rating><explanation>...</explanation>'

    See run_inline_judge in core/judges.py for the parser.
    """
    user_q = list(user_responses or [])
    asst_q = list(assistant_responses or [])
    judge_q = list(judge_responses or [])

    def _side_effect(*args, **kwargs):
        # acall_llm signature: (models, alias, messages, **kwargs)
        alias = args[1] if len(args) >= 2 else kwargs.get("alias", "")
        if alias == "user_model":
            queue = user_q
        elif alias == "assistant_model":
            queue = asst_q
        elif alias == "judge_model":
            queue = judge_q
        else:
            raise AssertionError(
                f"unexpected acall_llm alias={alias!r}; queues: "
                f"user={len(user_q)} assistant={len(asst_q)} "
                f"judge={len(judge_q)}"
            )
        if not queue:
            raise AssertionError(
                f"test consumed more {alias!r} responses than expected; "
                f"args_head={args[:2]} kwargs_keys={list(kwargs)}"
            )
        return queue.pop(0)

    return _side_effect


@contextmanager
def _patched_call_llm(side_effect):
    """Patch acall_llm in BOTH core.simulation AND core.judges.

    Both modules locally re-import acall_llm from core.llm at module
    load, so patching core.llm.acall_llm doesn't propagate. This
    context manager patches both call sites at once.
    """
    with patch(
        "usersim.engine.core.simulation.acall_llm",
        side_effect=side_effect,
    ), patch(
        "usersim.engine.core.judges.acall_llm",
        side_effect=side_effect,
    ):
        yield


