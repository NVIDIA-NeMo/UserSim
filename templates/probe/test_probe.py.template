    async def test_bank_load_failure_aborts(
        self, en_persona, simulator_cfg, models,
    ) -> None:
        with patch.dict(
            os.environ,
            {"USERSIM_YOUR_BANK": "/nonexistent/bank.yaml"},
        ):
            result = await probe_gen.simulate_YOUR_PROBE(
                models=models, data={}, persona=en_persona,
                profile={}, locale="en_US", language="English",
