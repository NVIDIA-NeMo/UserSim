class TestSimulateYourProbe:

    # 1. Registry registration.
    def test_registered_in_probe_registry(self) -> None:
        import sys
        assert PROBE_LABEL in _PROBE_REGISTRY
        probe_cls = resolve_probe(PROBE_LABEL)
        module = sys.modules[probe_cls.__module__]
        assert module.PROBE_FAMILY == PROBE_LABEL
        assert module.PROMPT_VERSION  # non-empty
        assert module.PROBE_VARIANTS  # non-empty

    # 2. Single-turn end-to-end (verbatim or generate-and-gate).
    async def test_single_turn_end_to_end(
        self, en_persona, simulator_cfg, models,
    ) -> None:
        side_effect = _mock_call_llm(
            assistant_responses=[
                {"role": "assistant", "content": "OK, here's an answer."},
            ],
            # If verbatim turn-1: no user_responses needed.
            # If generate-and-gate turn-1: provide a user response + judge XML.
            user_responses=[],
            judge_responses=[],
        )
        with _patched_call_llm(side_effect):
            result = await probe_gen.simulate_YOUR_PROBE(  # rename to your shim
                models=models, data={}, persona=en_persona,
                profile={}, locale="en_US", language="English",
                cfg=simulator_cfg, provenance=Provenance(),
            )
        assert result["conversation_status"] is True

